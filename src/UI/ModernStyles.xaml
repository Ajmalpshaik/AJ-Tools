<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Colors - Revit-UI skill DARK theme (exact values).
         Key NAMES are kept stable (every window binds to them); only values changed.
         Skill brush-name aliases are added below so new UI can use skill vocabulary.
         ============================================================ -->

    <!-- Surfaces -->
    <!-- Surface / page background (Mica Dark Fallback) -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#FF202020"/>
    <!-- SoftCard (slightly raised) -->
    <SolidColorBrush x:Key="BackgroundMedium" Color="#FF2D2D2D"/>
    <!-- Raised header band -->
    <SolidColorBrush x:Key="BackgroundLight" Color="#FF323232"/>
    <!-- Card / panel surface -->
    <SolidColorBrush x:Key="CardBackground" Color="#FF2B2B2B"/>

    <!-- Accents: Primary = WinUI Accent. -->
    <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#FF0F7B0F"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#FFF7630C"/>
    <!-- Secondary button / hover fill -->
    <SolidColorBrush x:Key="AccentGray" Color="#FF333333"/>
    <SolidColorBrush x:Key="AccentMagenta" Color="#FFB146C2"/>
    <SolidColorBrush x:Key="AccentDanger" Color="#FFE81123"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F7FA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFA8B4BE"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#FF6E7882"/>
    <!-- Dark text for use ONLY on genuinely BRIGHT fills (neon cyan, amber, white badges).
         NOT readable on the WinUI accents below (#0078D4 blue / #0F7B0F green / #E81123 red) -
         those medium-dark fills take TextOnAccent (white) instead. -->
    <SolidColorBrush x:Key="TextOnLight" Color="#FF0B1418"/>
    <!-- Light text for the accent button/selection fills (blue/green/red) - readability fix 2026-07-23 -->
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSuccess" Color="#FF81C784"/>

    <!-- Borders / overlay -->
    <SolidColorBrush x:Key="BorderSoft" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="BorderGlow" Color="#660078D4"/>
    <SolidColorBrush x:Key="OverlayBackground" Color="#CC202020"/>

    <!-- Skill brush-name aliases (same colors, skill's standard vocabulary) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF268CDA"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF005A9E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="SoftCardBrush" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F7FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FFA8B4BE"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE81123"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF7630C"/>

    <!-- ============================================================
         Motion (v1.3.0) - one shared feel for every AJ Tools control.

         Timing budget (motion-design): hover under 100ms, press under 150ms,
         release/settle 200-300ms. Everything decelerates (CubicEase EaseOut) so a
         control reads as finished well before it stops moving. Deliberately short:
         these are working dialogs opened many times a day, not a showcase.

         TWO HOUSE RULES BAKED IN BELOW - keep them if this file is edited:
         1. NEVER animate Background or Foreground here. Several windows set those two
            directly from code-behind (About's nav buttons, PipeSizing's mode toggles),
            and a running animation outruns a locally-set value, which would break the
            state colouring. Animate an overlay element's Opacity or a RenderTransform
            instead - both are template-internal, so no code-behind can collide with them.
         2. ONE trigger per animated property. Hover, press and focus each drive their own
            overlay, so they can never fight over who wrote last when several are true at
            once (hovering while pressed, pressing while focused).
         ============================================================ -->
    <CubicEase x:Key="MotionEaseOut" EasingMode="EaseOut"/>

    <!-- Typography -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="30"/>
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="DisabledText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Monospace for element IDs, GUIDs, file paths, parameter codes (skill: Consolas). -->
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Global -->
    <Style x:Key="ModernWindow" TargetType="Window">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="MinWidth" Value="380"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- No implicit Foreground to keep button text contrast correct -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="Background" Value="{StaticResource BorderSoft}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Replaced by the animated FocusRing below - the OS dotted rectangle would sit outside the
             rounded corner and fight the house look. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Layout is unchanged from v1.2.0: InnerFill still owns the padding and the
                         content, so no button changes size. The three overlays sit on top of it and
                         only ever have their Opacity animated. -->
                    <Grid x:Name="Root" Margin="2" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="InnerFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <!-- Hover lift: a soft white wash. Works over every button colour (blue, grey,
                             green, red, and anything a window sets from code-behind). -->
                        <Border x:Name="HoverGlow" CornerRadius="4" Background="#1FFFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <!-- Press shade: matches the old 0.7-opacity dim, but eased. -->
                        <Border x:Name="PressShade" CornerRadius="4" Background="#33000000"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="4" BorderBrush="#99FFFFFF" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Foreground stays a plain Setter on purpose: a Setter loses to a
                                 code-behind local value, an animation would not. -->
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Control Buttons -->
    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The hover/press COLOURS stay plain Setters here on purpose: WindowCloseButton
                         overrides the hover fill with red from a Style trigger, which only works
                         because these are Setters. Only the press dip is animated. -->
                    <Border x:Name="ControlFill" Background="{TemplateBinding Background}" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ControlScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#20FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#10FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ControlScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.10"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="ControlScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.10"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ControlScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="ControlScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close Button specifically highlights Red on hover -->
    <Style x:Key="WindowCloseButton" BasedOn="{StaticResource WindowControlButton}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"/>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentGray}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentDanger}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
    </Style>

    <Style x:Key="CompactSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Inputs -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- The blue edge used to be an instant BorderBrush swap. It is now two rings
                         that fade: one owned by hover, one by focus, so neither can overwrite the
                         other when the box is hovered AND focused. The field's own BorderBrush is
                         left alone, so a window can still colour it from code-behind. -->
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="FieldFill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <Border x:Name="HoverRing" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource AccentBlue}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource AccentBlue}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ModernComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="ComboToggleBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
            <Grid>
                <Path x:Name="ComboArrow"
                      Data="M 0 0 L 5 5 L 10 0 Z"
                      Fill="{StaticResource TextSecondary}"
                      Width="10"
                      Height="5"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ComboArrowRotate" Angle="0"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ComboToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                <Setter TargetName="ComboArrow" Property="Fill" Value="{StaticResource AccentBlue}"/>
                <!-- The arrow turns to point up while the list is open, and back when it closes. -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ComboArrowRotate" Storyboard.TargetProperty="Angle"
                                             To="180" Duration="0:0:0.18"
                                             EasingFunction="{StaticResource MotionEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ComboArrowRotate" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.18"
                                             EasingFunction="{StaticResource MotionEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboToggleBorder" Property="Opacity" Value="0.7"/>
                <Setter TargetName="ComboArrow" Property="Fill" Value="{StaticResource TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Template="{StaticResource ModernComboToggleTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="10,0,30,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False"/>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="10,0,30,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{StaticResource AccentBlue}"
                                 Visibility="Hidden"
                                 Focusable="True"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupBorder"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,8,8"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer Margin="2"
                                              SnapsToDevicePixels="True"
                                              CanContentScroll="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="ComboItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <!-- Highlight fades in as an overlay so it reads the same over an unselected
                             row and over the blue selected row. Selection itself stays instant. -->
                        <Border x:Name="HighlightGlow" CornerRadius="6" BorderThickness="1"
                                Background="#18FFFFFF" BorderBrush="{StaticResource AccentBlue}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HighlightGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HighlightGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ComboItemBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            <Setter TargetName="ComboItemBorder" Property="Background" Value="{StaticResource AccentBlue}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

