<!--
  Tool Name: Automatic Dimension - Settings
  Description: Row layout, offsets, side placement, dimension types, datum filtering and link options
               for the Automatic Dimension (grids / levels) tools.
  Author: Ajmal P.S.
  Version: 1.0.0
  Last Updated: 2026-08-15
  Revit Version: 2020 - latest
  Dependencies: AJTools.UI.ModernStyles
-->
<Window x:Class="AJTools.UI.Dimensioning.AutoDatumDimensionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automatic Dimension Settings - AJ Tools"
        Width="700" Height="760"
        MinWidth="640" MinHeight="620"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource DisabledText}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <Grid Margin="10">
            <Border Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Automatic Dimension" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Controls the grid and level dimension rows: how many, where they sit, which style they use, and which datums are included."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">

                            <TextBlock Text="1. Which rows to create" Style="{StaticResource SectionHeading}"/>

                            <CheckBox x:Name="IndividualRowCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Chain through every grid or level"
                                      Margin="0,0,0,4"/>

                            <CheckBox x:Name="OverallRowCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Overall row from the first to the last"
                                      Margin="0,0,0,4"/>

                            <CheckBox x:Name="SkipOverallForTwoCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Leave the overall row out when there are only two"
                                      Margin="18,0,0,4"/>

                            <TextBlock Style="{StaticResource HintText}" Margin="18,0,0,6"
                                       Text="With only two datums the overall row repeats the chain exactly, one row further out."/>

                            <TextBlock Text="2. Where the rows sit" Style="{StaticResource SectionHeading}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="SidePrimaryRadio"
                                             Style="{StaticResource ModernRadioButton}"
                                             GroupName="Side"
                                             Content="One side"
                                             Margin="0,0,18,0"/>
                                <RadioButton x:Name="SideSecondaryRadio"
                                             Style="{StaticResource ModernRadioButton}"
                                             GroupName="Side"
                                             Content="The opposite side"
                                             Margin="0,0,18,0"/>
                                <RadioButton x:Name="SideBothRadio"
                                             Style="{StaticResource ModernRadioButton}"
                                             GroupName="Side"
                                             Content="Both sides"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Grids are dimensioned above or below the drawing; levels to the left or right. Both sides gives a matching set on each."/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Gap to the first row" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" x:Name="FirstOffsetBox" Style="{StaticResource ModernTextBox}"/>
                                <TextBlock Grid.Column="2" Text="mm on paper" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Gap between rows" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" x:Name="RowSpacingBox" Style="{StaticResource ModernTextBox}"/>
                                <TextBlock Grid.Column="2" Text="mm on paper" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Both gaps are paper millimetres and are scaled by the view, so they look the same at 1:50 and 1:100."/>

                            <TextBlock Text="3. Dimension styles" Style="{StaticResource SectionHeading}"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Chain row" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="IndividualTypeCombo" MaxWidth="340" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Overall row" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="OverallTypeCombo" MaxWidth="340" HorizontalAlignment="Left"/>
                            </Grid>

                            <TextBlock Text="4. Which grids and levels to use" Style="{StaticResource SectionHeading}"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Grids from" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="GridScopeCombo" MaxWidth="340" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Levels from" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="LevelScopeCombo" MaxWidth="340" HorizontalAlignment="Left"/>
                            </Grid>

                            <TextBlock x:Name="LinkWarningText"
                                       Style="{StaticResource HintText}"
                                       Foreground="{StaticResource AccentOrange}"
                                       Text="Revit can drop dimensions that point at a linked grid or level when that link is reloaded or the project is reopened."/>

                            <CheckBox x:Name="StoryLevelsOnlyCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Only use levels marked as a building story"
                                      Margin="0,4,0,6"/>

                            <TextBlock Text="Skip any grid or level whose name contains" Margin="0,0,0,4"/>
                            <TextBox x:Name="ExcludeBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Separate several with a semicolon, for example:  .1 ; SEC ; TEMP.  Leave empty to use them all."/>

                            <TextBlock Text="5. Safety" Style="{StaticResource SectionHeading}"/>

                            <CheckBox x:Name="SkipDimensionedCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Skip grids and levels that already have a dimension in this view"
                                      Margin="0,0,0,4"/>

                            <CheckBox x:Name="RequireCropCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Only run when the view is cropped"
                                      Margin="0,0,0,4"/>

                            <TextBlock Style="{StaticResource HintText}" Margin="18,0,0,6"
                                       Text="Leave this off and an uncropped view is measured from the grids and levels themselves, instead of the tool refusing to run."/>

                            <CheckBox x:Name="ShowReportCheck"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Tell me when something was skipped or could not be dimensioned"
                                      Margin="0,0,0,4"/>

                            <TextBlock Style="{StaticResource HintText}" Margin="18,0,0,6"
                                       Text="A run that dimensioned everything never shows a message - the dimensions are the result. This only speaks up when something was left out."/>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="ErrorText"
                               Foreground="{StaticResource AccentDanger}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,4"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button x:Name="ResetButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Reset to defaults"
                                Width="140"
                                Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Save"
                                Width="110"
                                IsDefault="True"
                                Margin="0,0,8,0"/>
                        <Button x:Name="CancelButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Cancel"
                                Width="110"
                                IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
