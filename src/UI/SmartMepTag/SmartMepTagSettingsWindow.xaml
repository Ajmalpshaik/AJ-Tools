<!--
  Tool Name: Smart MEP Tagging - Settings
  Description: Enable/disable and prioritise the MEP categories Smart MEP Tags will process, plus the
               skip-vertical-runs rule shared with Create Tags and Stack Tags.
  Author: Ajmal P.S.
  Version: 1.0.0
  Last Updated: 2026-07-28
  Revit Version: 2020 - latest
  Dependencies: AJTools.UI.ModernStyles
-->
<Window x:Class="AJTools.UI.SmartMepTag.SmartMepTagSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart MEP Tag Settings - AJ Tools"
        Width="640"
        Height="580"
        MinWidth="560"
        MinHeight="520"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SmartTagGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <Grid Margin="10">
            <Border Style="{StaticResource PanelCard}">
                <Grid>
                    <!-- Header, tabs, validation, buttons. The validation message and the buttons stay
                         OUTSIDE the TabControl on purpose: an error raised by a box on Advanced must
                         still be readable while the other tab is showing. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Smart MEP Tag Settings"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Tick the categories Smart MEP Tags should tag, and set each one's priority. High-priority categories claim the best clash-free positions first in crowded areas."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <TabControl x:Name="SettingsTabs" Grid.Row="1">
                    <TabItem Header="What to tag">
                    <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Quick actions -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Content="Tag all"
                                Style="{StaticResource CompactSecondaryButton}"
                                MinWidth="80"
                                Margin="0,0,6,0"
                                Click="OnTagAll"
                                ToolTip="Tick every category."/>
                        <Button Content="Tag none"
                                Style="{StaticResource CompactSecondaryButton}"
                                MinWidth="80"
                                Click="OnTagNone"
                                ToolTip="Untick every category."/>
                    </StackPanel>

                    <!-- Category grid -->
                    <!-- Same two fixes as the Create Tags grid: AutoGenerateColumns defaults to TRUE
                         and would add a column per public property alongside the ones defined below,
                         and without a MinHeight the list collapses as the content under it grows. -->
                    <DataGrid x:Name="CategoryGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              MinHeight="180"
                              Style="{StaticResource ModernDataGrid}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternationCount="2"
                              RowBackground="{StaticResource CardBackground}"
                              AlternatingRowBackground="{StaticResource BackgroundMedium}"
                              RowHeight="34"
                              ColumnHeaderStyle="{StaticResource SmartTagGridHeaderStyle}">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tag?" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Element Type"
                                                Binding="{Binding CategoryLabel, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTextColumn Header="In Model"
                                                Binding="{Binding CountInModel, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="90"/>
                            <DataGridTemplateColumn Header="Priority" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding PriorityOptions}"
                                                  SelectedItem="{Binding PriorityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="4,2"
                                                  ToolTip="Controls tagging order: High categories claim the best available positions first."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Leader?" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding UseLeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Untick to place this category's tags beside the element with no leader line - useful for accessories. If that spot clashes the tag moves to the other side, and only then falls back to the normal clash handling."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Tagging rule shared with Create Tags and Stack Tags -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <CheckBox x:Name="SkipVerticalBox"
                                  Content="Skip vertical ducts, pipes and cable trays"
                                  Style="{StaticResource ModernCheckBox}"
                                  ToolTip="A run going straight up or down is skipped instead of tagged."/>
                        <TextBlock Text="The same setting as on Create Tags Settings - change it in either place and all three tagging tools follow it."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    </Grid>
                    </TabItem>

                    <TabItem Header="Advanced">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="2,12,8,0">

                                <TextBlock Text="How small is too small to tag"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="These apply to ducts, pipes and cable trays only. Accessories and equipment are always tagged whatever their size."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Shortest run worth tagging"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MinLengthBox"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"
                                             MaxLength="10"
                                             TextChanged="OnValueChanged"
                                             ToolTip="A run shorter than this is skipped. Set 0 to tag every length."/>
                                    <TextBlock Grid.Column="1"
                                               Text="mm"
                                               FontSize="12"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </Grid>
                                <TextBlock Text="Real length in the model, not on the sheet. 0 means no minimum."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                                <CheckBox x:Name="FilterBySizeBox"
                                          Content="Also filter by size"
                                          Style="{StaticResource ModernCheckBox}"
                                          Margin="0,16,0,0"
                                          Checked="OnFilterBySizeToggled"
                                          Unchecked="OnFilterBySizeToggled"
                                          ToolTip="Untick to tag every run whatever its cross-section, leaving length as the only test."/>

                                <StackPanel x:Name="SizePanel" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MinWidthBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource ModernTextBox}"
                                                 MaxLength="10"
                                                 TextChanged="OnValueChanged"
                                                 ToolTip="Narrower than this and the run is skipped. 0 means no width minimum."/>
                                        <TextBlock Grid.Column="1"
                                                   Text="mm wide"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="MinHeightBox"
                                                 Grid.Column="3"
                                                 Style="{StaticResource ModernTextBox}"
                                                 MaxLength="10"
                                                 TextChanged="OnValueChanged"
                                                 ToolTip="Shallower than this and the run is skipped. 0 means no height minimum."/>
                                        <TextBlock Grid.Column="4"
                                                   Text="mm high"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>
                                    <TextBlock Text="A run is skipped when it is under EITHER figure - a 400 x 50 duct is skipped against 100 x 100, because 50 is under 100. Round pipes and round ducts use their diameter as both. Set a figure to 0 to stop it being tested."
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <TextBlock Text="These are remembered after you close Revit."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,16,0,0"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    </TabControl>

                    <!-- Inline validation message -->
                    <TextBlock x:Name="ErrorText"
                               Grid.Row="2"
                               FontSize="12"
                               Foreground="{StaticResource AccentDanger}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                    <!-- Buttons -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="ResetButton"
                                Content="Reset to defaults"
                                Style="{StaticResource CompactSecondaryButton}"
                                MinWidth="128"
                                Click="OnReset"
                                ToolTip="Tick every category, put each priority back to its default, and switch vertical-run skipping back on."/>

                        <Button Grid.Column="2"
                                x:Name="SaveButton"
                                Content="Save"
                                Style="{StaticResource ModernButton}"
                                MinWidth="104"
                                Margin="0,0,8,0"
                                IsDefault="True"
                                Click="OnSave"/>

                        <Button Grid.Column="3"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                IsCancel="True"
                                Click="OnCancel"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
