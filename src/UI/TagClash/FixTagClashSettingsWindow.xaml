<!--
  Tool Name: Fix Tag Clash - Settings
  Description: Rounds, drift limit, mark colour and matching rules for the tag clash engine.
  Author: Ajmal P.S.
  Version: 1.0.0
  Last Updated: 2026-08-16
  Revit Version: 2020 - latest
  Dependencies: AJTools.UI.ModernStyles
-->
<Window x:Class="AJTools.UI.TagClash.FixTagClashSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix Tag Clash Settings - AJ Tools"
        Width="520"
        Height="640"
        MinWidth="480"
        MinHeight="560"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PresetChip" TargetType="Button" BasedOn="{StaticResource CompactSecondaryButton}">
                <Setter Property="MinWidth" Value="44"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
            </Style>

            <Style x:Key="ColourChoice" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
                <Setter Property="Margin" Value="0,0,14,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer credit -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <Grid Margin="10">
            <Border Style="{StaticResource PanelCard}">
                <DockPanel>

                    <!-- Buttons pinned to the bottom -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="ResetButton"
                                Content="Reset to defaults"
                                Style="{StaticResource CompactSecondaryButton}"
                                MinWidth="128"
                                Click="OnReset"/>

                        <Button Grid.Column="2"
                                x:Name="SaveButton"
                                Content="Save"
                                Style="{StaticResource ModernButton}"
                                MinWidth="104"
                                Margin="0,0,8,0"
                                IsDefault="True"
                                Click="OnSave"/>

                        <Button Grid.Column="3"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                IsCancel="True"
                                Click="OnCancel"/>
                    </Grid>

                    <!-- Inline validation message -->
                    <TextBlock DockPanel.Dock="Bottom"
                               x:Name="ErrorText"
                               FontSize="12"
                               Foreground="{StaticResource AccentDanger}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Fix Tag Clash Settings"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Tags are placed first and separated afterwards. These settings control how hard the tool tries, and how far a tag is allowed to move."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>

                            <!-- Rounds -->
                            <TextBlock Text="How many rounds to try" Style="{StaticResource SectionHeading}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PassesBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="4"
                                         TextChanged="OnValueChanged"
                                         ToolTip="Each round separates what it can, then looks again. More rounds fix more, but take longer."/>
                                <TextBlock Grid.Column="1"
                                           Text="rounds"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="3" Tag="3" Style="{StaticResource PresetChip}" Click="OnPassPreset"/>
                                <Button Content="5" Tag="5" Style="{StaticResource PresetChip}" Click="OnPassPreset"/>
                                <Button Content="10" Tag="10" Style="{StaticResource PresetChip}" Click="OnPassPreset"/>
                                <Button Content="20" Tag="20" Style="{StaticResource PresetChip}" Click="OnPassPreset"/>
                                <Button Content="30" Tag="30" Style="{StaticResource PresetChip}" Click="OnPassPreset"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="It stops early as soon as nothing is clashing, so a high number costs nothing on a clean view."/>

                            <!-- Drift limit -->
                            <TextBlock Text="How far a tag may move" Style="{StaticResource SectionHeading}" Margin="0,16,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DriftBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="12"
                                         TextChanged="OnValueChanged"
                                         ToolTip="Measured on the printed sheet, from where the tag started."/>
                                <TextBlock Grid.Column="1"
                                           Text="mm"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Millimetres on the printed sheet. A tag that would have to travel further than this is left alone and marked instead, so no tag ends up far from the element it belongs to."/>

                            <!-- Mark colour -->
                            <TextBlock Text="Colour for tags that could not be separated"
                                       Style="{StaticResource SectionHeading}"
                                       Margin="0,16,0,5"/>
                            <WrapPanel Orientation="Horizontal">
                                <RadioButton x:Name="ColourRed" Content="Red" GroupName="MarkColour" Style="{StaticResource ColourChoice}"/>
                                <RadioButton x:Name="ColourGreen" Content="Green" GroupName="MarkColour" Style="{StaticResource ColourChoice}"/>
                                <RadioButton x:Name="ColourOrange" Content="Orange" GroupName="MarkColour" Style="{StaticResource ColourChoice}"/>
                                <RadioButton x:Name="ColourBlue" Content="Blue" GroupName="MarkColour" Style="{StaticResource ColourChoice}"/>
                                <RadioButton x:Name="ColourMagenta" Content="Magenta" GroupName="MarkColour" Style="{StaticResource ColourChoice}"/>
                            </WrapPanel>
                            <CheckBox x:Name="MarkFailuresBox"
                                      Content="Colour the tags that could not be separated"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="The colour is a view override and stays until you run Clear Tag Clash Marks. Unfixed tags are always left selected, whether they are coloured or not."/>

                            <!-- Matching rules -->
                            <TextBlock Text="How hard to try" Style="{StaticResource SectionHeading}" Margin="0,16,0,5"/>
                            <CheckBox x:Name="FullSearchBox"
                                      Content="Try the other side and sliding along the run before moving up or down"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Slower per tag, but it only ever runs on the few tags that actually clash. Turn it off for plain up-and-down moves only."/>

                            <!-- Advanced, hidden until asked for -->
                            <CheckBox x:Name="ShowAdvancedBox"
                                      Content="Show advanced settings"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,18,0,0"
                                      Checked="OnAdvancedToggled"
                                      Unchecked="OnAdvancedToggled"
                                      ToolTip="What counts as a clash. You will rarely need to change these."/>

                            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="What counts as a clash" Style="{StaticResource SectionHeading}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ToleranceBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="10"
                                         TextChanged="OnValueChanged"
                                         ToolTip="Overlap smaller than this is ignored."/>
                                <TextBlock Grid.Column="1"
                                           Text="mm overlap"
                                           FontSize="11"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="GapBox"
                                         Grid.Column="3"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="10"
                                         TextChanged="OnValueChanged"
                                         ToolTip="Two tags closer than this count as clashing even when they do not overlap."/>
                                <TextBlock Grid.Column="4"
                                           Text="mm gap"
                                           FontSize="11"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Both on the printed sheet. The defaults (1.5mm and 5mm) are the values Smart MEP Tags has been using all along."/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
