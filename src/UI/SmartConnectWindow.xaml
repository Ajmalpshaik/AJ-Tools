<!--
  Tool Name: Connect MEP Elements (Smart Connect) - Settings Window
  Description: Settings for how Connect MEP Elements routes, what it may pick, and what it copies.
  Author: Ajmal P.S.
  Version: 2.1.0
  Last Updated: 2026-08-15
  Revit Version: 2020
  Dependencies: AJTools.Models, AJTools.Services.SmartConnect

  Layout note: only the four choices a modeller actually changes day to day sit on the main page.
  Everything else is real, kept, and correct out of the box - it lives under "Advanced settings",
  collapsed, with a plain-English line under each control saying when you would touch it.
-->
<Window x:Class="AJTools.UI.SmartConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect MEP Elements - Settings"
        Width="560"
        Height="660"
        MinWidth="500"
        MinHeight="480"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- The one-line "what is this for" under a control. -->
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="26,0,0,10"/>
            </Style>

            <Style x:Key="GroupHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="OptionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="OptionRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Action bar -->
        <Grid DockPanel.Dock="Bottom" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ErrorText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentDanger}"
                       TextWrapping="Wrap"
                       Margin="0,0,10,0"/>

            <Button Grid.Column="1"
                    Content="Reset"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Click="OnResetClick"/>

            <Button Grid.Column="2"
                    Content="Save"
                    Style="{StaticResource ModernButton}"
                    IsDefault="True"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="OnOkClick"/>

            <Button Grid.Column="3"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="110"
                    Click="OnCancelClick"/>
        </Grid>

        <Grid Margin="12,12,12,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Connect MEP Elements"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Saved and remembered. The button then connects straight away without asking."
                                       Style="{StaticResource GroupHint}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- ============ 1. Bend angle ============ -->
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="Bend angle"
                                           Style="{StaticResource SectionHeader}"/>

                                <RadioButton x:Name="Angle90Radio"
                                             Grid.Row="1" Grid.ColumnSpan="2"
                                             Content="90&#176; — square across, takes the least room"
                                             GroupName="AnglePreset"
                                             Style="{StaticResource OptionRadioButton}"
                                             Checked="OnPresetAngleChecked"/>

                                <RadioButton x:Name="Angle45Radio"
                                             Grid.Row="2" Grid.ColumnSpan="2"
                                             Content="45&#176; — gentler on flow, needs more length"
                                             GroupName="AnglePreset"
                                             Style="{StaticResource OptionRadioButton}"
                                             Checked="OnPresetAngleChecked"
                                             Margin="0,6,0,2"/>

                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                           Text="Something else — type it, press Add, then pick it from the list (5&#176; to 90&#176;)"
                                           Style="{StaticResource GroupHint}"
                                           Margin="0,8,0,6"/>

                                <TextBox x:Name="CustomAngleBox"
                                         Grid.Row="4"
                                         Grid.Column="0"
                                         Height="28"
                                         Style="{StaticResource ModernTextBox}"
                                         VerticalContentAlignment="Center"/>

                                <Button x:Name="AddAngleButton"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Content="Add"
                                        Style="{StaticResource ModernButton}"
                                        MinWidth="90"
                                        Margin="8,0,0,0"
                                        Click="OnAddCustomAngleClick"/>

                                <ListBox x:Name="CustomAnglesList"
                                         Grid.Row="5"
                                         Grid.ColumnSpan="2"
                                         MinHeight="60"
                                         MaxHeight="110"
                                         Margin="0,8,0,0"
                                         Style="{StaticResource ModernListBox}"
                                         ItemContainerStyle="{StaticResource ModernListBoxItem}"
                                         SelectionMode="Single"
                                         SelectionChanged="OnCustomAnglesSelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- ============ 2. Which pipe may move ============ -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Which pipe is allowed to move" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource GroupHint}"
                                           Text="To join two runs, one or both usually has to grow or be cut back. This is who gets changed."/>

                                <RadioButton x:Name="MoveBothRadio"
                                             Content="Both — they share it equally"
                                             GroupName="MoveMode"
                                             Style="{StaticResource OptionRadioButton}"/>
                                <RadioButton x:Name="MoveFirstRadio"
                                             Content="Only the first one I pick"
                                             GroupName="MoveMode"
                                             Style="{StaticResource OptionRadioButton}"
                                             Margin="0,6,0,2"/>
                                <RadioButton x:Name="MoveSecondRadio"
                                             Content="Only the second one I pick"
                                             GroupName="MoveMode"
                                             Style="{StaticResource OptionRadioButton}"
                                             Margin="0,6,0,2"/>
                                <RadioButton x:Name="MoveNoneRadio"
                                             Content="Neither — leave both alone and add new pieces"
                                             GroupName="MoveMode"
                                             Style="{StaticResource OptionRadioButton}"
                                             Margin="0,6,0,2"/>

                                <TextBlock Style="{StaticResource GroupHint}"
                                           Margin="0,8,0,0"
                                           Text="Equipment, air terminals and flex can never be cut, so they are always left alone whatever you choose here."/>
                            </StackPanel>
                        </Border>

                        <!-- ============ 3. Selecting a lot at once ============ -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="When you select a lot at once" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource GroupHint}"
                                           Text="Select a group of elements before clicking the button and it pairs them up by their nearest free ends and joins the lot in one go."/>

                                <TextBlock Text="Do not join ends further apart than (mm)"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="12"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="MaxPairDistanceBox"
                                         Height="28"
                                         Width="140"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource ModernTextBox}"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ 4. Clash warning ============ -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <CheckBox x:Name="WarnOnClashCheck"
                                          Content="Warn me if the new run hits something"
                                          Style="{StaticResource OptionCheckBox}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Margin="26,4,0,0"
                                           Text="Checks the new pieces against walls, floors, beams and other services. Leave it off unless you want it — it is the only setting here that slows the tool down."/>
                            </StackPanel>
                        </Border>

                        <!-- ============ Advanced toggle ============ -->
                        <Button x:Name="AdvancedToggleButton"
                                Content="Show advanced settings"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                MinWidth="200"
                                Margin="0,2,0,10"
                                Click="OnToggleAdvancedClick"/>

                        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">

                            <TextBlock Style="{StaticResource GroupHint}"
                                       Margin="0,0,0,10"
                                       Text="These are already set the way they should be. Nothing below needs changing to use the tool — each one says what it is for."/>

                            <!-- How it makes room -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="How it makes room for the new run" Style="{StaticResource SectionHeader}"/>

                                    <RadioButton x:Name="ModeAutoRadio"
                                                 Content="Work it out for me"
                                                 GroupName="RoutingMode"
                                                 Style="{StaticResource OptionRadioButton}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Tries cutting the pipes back first; if that will not work, it leaves them alone and adds new pieces instead. Leave it here."/>

                                    <RadioButton x:Name="ModeSingleElbowRadio"
                                                 Content="Always cut the picked pipes back"
                                                 GroupName="RoutingMode"
                                                 Style="{StaticResource OptionRadioButton}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Fewest new elements, but it fails outright on anything that cannot be cut, like a pump or a flex duct."/>

                                    <RadioButton x:Name="ModeOffsetRadio"
                                                 Content="Never touch the picked pipes"
                                                 GroupName="RoutingMode"
                                                 Style="{StaticResource OptionRadioButton}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="26,0,0,0"
                                               Text="Everything is added around them. Use it when the two runs are set out correctly and must not shift by even a millimetre."/>
                                </StackPanel>
                            </Border>

                            <!-- What you are allowed to pick -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="What you are allowed to pick" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Style="{StaticResource GroupHint}"
                                               Text="Pipe, Duct and Cable Tray are always allowed. Turn one of these off only if you keep picking that kind by mistake."/>

                                    <CheckBox x:Name="AllowConduitCheck"
                                              Content="Conduit"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Treated exactly like the other straight runs."/>

                                    <CheckBox x:Name="AllowFlexCheck"
                                              Content="Flex Duct and Flex Pipe"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="You can connect to them, but they are never cut or straightened — a new piece is run up to them."/>

                                    <CheckBox x:Name="AllowFamilyInstanceCheck"
                                              Content="Equipment, air terminals, fittings and accessories"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Anything with a spare connector. This is what lets you run a duct straight into a grille or an AHU."/>

                                    <CheckBox x:Name="AllowNonParallelCheck"
                                              Content="Runs that are not parallel to each other"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="26,0,0,0"
                                               Text="Covers runs that cross at an angle and runs that pass by each other at different levels. Switch it off and only dead-parallel ends are accepted, which is how the old version behaved."/>
                                </StackPanel>
                            </Border>

                            <!-- If the angle will not fit -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="If your angle will not fit" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="AngleFallbackCheck"
                                              Content="Try 45&#176;, 30&#176;, 60&#176;, 90&#176; rather than give up"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="26,0,0,0"
                                               Text="Sometimes there is not enough length for the angle you asked for. This makes it fall back instead of failing, and it tells you afterwards which angle it actually used."/>
                                </StackPanel>
                            </Border>

                            <!-- How it behaves while you work -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="How it behaves while you work" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="BatchFromSelectionCheck"
                                              Content="Use my selection instead of asking me to pick"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Off means it always asks you to pick pairs, even when you already had things selected."/>

                                    <CheckBox x:Name="SingleUndoCheck"
                                              Content="One undo for a whole selection"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Off means each pair becomes its own undo step, so you would press Ctrl+Z once per joint."/>

                                    <CheckBox x:Name="SummaryReportCheck"
                                              Content="Show a failed pair in the next prompt, not a popup"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="26,0,0,0"
                                               Text="While you are picking pair after pair, a failure appears on the status line of the next prompt so nothing interrupts you. Off means a popup you have to dismiss each time."/>
                                </StackPanel>
                            </Border>

                            <!-- Matching the run it joins -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Making the new pieces match" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="CopyInsulationCheck"
                                              Content="Copy insulation and lining"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Without this the new pieces come out bare, and an insulated run ends up with a gap in it."/>

                                    <CheckBox x:Name="CopyParametersCheck"
                                              Content="Copy Comments, Mark and Workset"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Keeps the new pieces on the same workset and carrying the same data as the run they join, so schedules stay clean."/>

                                    <CheckBox x:Name="AutoTransitionCheck"
                                              Content="Add a reducer when the two are different sizes"
                                              Style="{StaticResource OptionCheckBox}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="26,0,0,0"
                                               Text="Puts the size change in the middle of the new run, so the elbow at each end stays a plain same-size elbow."/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
