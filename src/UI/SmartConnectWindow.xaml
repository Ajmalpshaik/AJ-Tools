<!--
  Tool Name: Connect MEP Elements (Smart Connect) - Settings Window
  Description: Settings for how Connect MEP Elements routes, what it may pick, and what it copies.
  Author: Ajmal P.S.
  Version: 3.0.0
  Last Updated: 2026-08-16
  Revit Version: 2020
  Dependencies: AJTools.Models, AJTools.Services.SmartConnect

  Layout, all from Ajmal on 2026-08-16:
  - Two tabs instead of one long scrolling page with a collapsible block. Main carries the three
    things changed day to day; Advanced carries the rest.
  - Advanced explains itself through hover tooltips, not a permanent line of hint text under every
    control. That is what made the old page unreadably long.
  - "Show failed report" sits in the footer beside Reset/Save/Cancel, because it governs what happens
    while the tool RUNS rather than how it routes.
  - The old "How it makes room for the new run" card is gone entirely: the tool always stretches what
    was picked, so there is nothing left to choose.
-->
<Window x:Class="AJTools.UI.SmartConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect MEP Elements - Settings"
        Width="560"
        Height="640"
        MinWidth="520"
        MinHeight="470"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="GroupHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!--
              A plain string Content on a RadioButton/CheckBox does NOT wrap in WPF - it silently
              overflows past the window edge instead. Harmless at the default width, but ResizeMode is
              CanResize with MinWidth=520, and a long option would run past the border with no sign
              anything was cut off. This template fixes it everywhere at once.
            -->
            <DataTemplate x:Key="WrappingOptionContent">
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </DataTemplate>

            <Style x:Key="OptionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ContentTemplate" Value="{StaticResource WrappingOptionContent}"/>
                <!-- Long enough to actually read a full sentence before it vanishes. -->
                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            </Style>

            <Style x:Key="OptionRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ContentTemplate" Value="{StaticResource WrappingOptionContent}"/>
                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!--
          Action bar: the run-time option on the left, the window's own buttons on the right.
          ErrorText gets its OWN full-width row rather than a star column between the two, because
          with the checkbox and three buttons all sized Auto the leftover width collapses to almost
          nothing and a one-line validation message wrapped into five.
        -->
        <Grid DockPanel.Dock="Bottom" Margin="12,0,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="0"
                       Grid.ColumnSpan="5"
                       Foreground="{StaticResource AccentDanger}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <CheckBox x:Name="ShowFailedReportCheck"
                      Grid.Row="1"
                      Grid.Column="0"
                      Content="Show failed report"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      Style="{StaticResource ModernCheckBox}"
                      ToolTipService.ShowDuration="30000"
                      ToolTipService.InitialShowDelay="350"
                      ToolTip="Ticked: a popup appears right away naming the reason a connection failed.&#10;Unticked: nothing is shown - you simply try again."/>

            <Button Grid.Row="1" Grid.Column="2"
                    Content="Reset"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Click="OnResetClick"/>

            <Button Grid.Row="1" Grid.Column="3"
                    Content="Save"
                    Style="{StaticResource ModernButton}"
                    IsDefault="True"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Click="OnOkClick"/>

            <Button Grid.Row="1" Grid.Column="4"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="100"
                    Click="OnCancelClick"/>
        </Grid>

        <Grid Margin="12,12,12,8">
            <TabControl Background="Transparent" BorderThickness="0">

                <!-- ============================== MAIN ============================== -->
                <TabItem Header="Main">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,10,0,0">
                        <StackPanel>

                            <!-- Bend angle -->
                            <Border Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                               Text="Bend angle"
                                               Style="{StaticResource SectionHeader}"/>

                                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="2"
                                                 Columns="2"
                                                 Margin="0,0,0,6">
                                        <RadioButton x:Name="Angle90Radio"
                                                     Content="90&#176; — square across"
                                                     GroupName="AnglePreset"
                                                     Style="{StaticResource OptionRadioButton}"
                                                     Checked="OnPresetAngleChecked"/>

                                        <RadioButton x:Name="Angle45Radio"
                                                     Content="45&#176; — gentler on flow"
                                                     GroupName="AnglePreset"
                                                     Style="{StaticResource OptionRadioButton}"
                                                     Checked="OnPresetAngleChecked"/>
                                    </UniformGrid>

                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="90&#176; takes the least room. 45&#176; is kinder to flow but needs a longer run to fit."
                                               Style="{StaticResource GroupHint}"/>

                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                               Text="Something else — type it, press Add, then pick it from the list (5&#176; to 90&#176;)"
                                               Style="{StaticResource GroupHint}"
                                               Margin="0,4,0,6"/>

                                    <TextBox x:Name="CustomAngleBox"
                                             Grid.Row="4"
                                             Grid.Column="0"
                                             Height="28"
                                             Style="{StaticResource ModernTextBox}"
                                             VerticalContentAlignment="Center"/>

                                    <Button x:Name="AddAngleButton"
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Content="Add"
                                            Style="{StaticResource ModernButton}"
                                            MinWidth="90"
                                            Margin="8,0,0,0"
                                            Click="OnAddCustomAngleClick"/>

                                    <ListBox x:Name="CustomAnglesList"
                                             Grid.Row="5"
                                             Grid.ColumnSpan="2"
                                             MinHeight="58"
                                             MaxHeight="104"
                                             Margin="0,8,0,0"
                                             Style="{StaticResource ModernListBox}"
                                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                                             SelectionMode="Single"
                                             SelectionChanged="OnCustomAnglesSelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- Which element may move -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Which element is allowed to move" Style="{StaticResource SectionHeader}"/>

                                    <RadioButton x:Name="MoveBothRadio"
                                                 Content="Both — they share it equally"
                                                 GroupName="MoveMode"
                                                 Style="{StaticResource OptionRadioButton}"
                                                 ToolTip="The travel needed to meet is split evenly between the two elements you picked."/>
                                    <RadioButton x:Name="MoveFirstRadio"
                                                 Content="Only the first one I pick"
                                                 GroupName="MoveMode"
                                                 Style="{StaticResource OptionRadioButton}"
                                                 ToolTip="The second element never moves. The first one travels the whole distance."/>
                                    <RadioButton x:Name="MoveSecondRadio"
                                                 Content="Only the second one I pick"
                                                 GroupName="MoveMode"
                                                 Style="{StaticResource OptionRadioButton}"
                                                 ToolTip="The first element never moves. The second one travels the whole distance."/>

                                    <TextBlock Style="{StaticResource GroupHint}"
                                               Margin="0,2,0,0"
                                               Text="Your elements are always stretched to meet. Equipment, air terminals and flex can never be stretched, so a piece is run up to them instead."/>
                                </StackPanel>
                            </Border>

                            <!-- Clash warning -->
                            <Border Style="{StaticResource SectionCard}">
                                <CheckBox x:Name="WarnOnClashCheck"
                                          Content="Warn me if the new run hits something"
                                          Style="{StaticResource OptionCheckBox}"
                                          Margin="0"
                                          ToolTip="Checks anything the tool creates against walls, floors, beams and other services.&#10;Leave it off unless you want it - it is the only setting here that slows the tool down."/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================ ADVANCED ============================ -->
                <TabItem Header="Advanced">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,10,0,0">
                        <StackPanel>

                            <TextBlock Style="{StaticResource GroupHint}"
                                       Text="These are already set the way they should be. Hover any option to see what it does."/>

                            <!-- What you are allowed to pick -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="What you are allowed to pick" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Style="{StaticResource GroupHint}"
                                               Text="Pipe, Duct and Cable Tray are always allowed."/>

                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="AllowConduitCheck"
                                                  Content="Conduit"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="Treated exactly like the other straight runs - stretched to meet like a pipe or duct."/>

                                        <CheckBox x:Name="AllowFlexDuctCheck"
                                                  Content="Flex Duct"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="You can connect to it, but it is never stretched or straightened.&#10;A piece is run up to it instead."/>

                                        <CheckBox x:Name="AllowFlexPipeCheck"
                                                  Content="Flex Pipe"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="You can connect to it, but it is never stretched or straightened.&#10;A piece is run up to it instead."/>

                                        <CheckBox x:Name="AllowAirTerminalsCheck"
                                                  Content="Air terminals"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="Grilles and diffusers. This is what lets you run a duct straight into one."/>

                                        <CheckBox x:Name="AllowEquipmentCheck"
                                                  Content="Equipment"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="Mechanical equipment, plumbing fixtures, sprinklers, electrical equipment —&#10;anything else carrying a spare connector."/>

                                        <CheckBox x:Name="AllowFittingsCheck"
                                                  Content="Fittings"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="Pipe, duct, cable tray and conduit fittings that still have a spare connector."/>

                                        <CheckBox x:Name="AllowAccessoriesCheck"
                                                  Content="Accessories"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  ToolTip="Valves, dampers and similar in-line accessories with a spare connector."/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Shapes it will accept -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Shapes it will accept" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="AllowNonParallelCheck"
                                              Content="Runs that are not parallel to each other"
                                              Style="{StaticResource OptionCheckBox}"
                                              Margin="0"
                                              ToolTip="Covers runs that cross at an angle and runs that pass by each other at different levels.&#10;Switch it off and only dead-parallel facing ends are accepted, which is how the old version behaved."/>
                                </StackPanel>
                            </Border>

                            <!-- Angle fallback -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="If your angle will not fit" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="AngleFallbackCheck"
                                              Content="Try 45&#176;, 30&#176;, 60&#176;, 90&#176; rather than give up"
                                              Style="{StaticResource OptionCheckBox}"
                                              Margin="0"
                                              ToolTip="Sometimes there is not enough length for the angle you asked for.&#10;This falls back instead of failing, and tells you afterwards which angle it used."/>
                                </StackPanel>
                            </Border>

                            <!-- Behaviour while working -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="How it behaves while you work" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="BatchFromSelectionCheck"
                                              Content="If exactly two are already selected, connect them directly"
                                              Style="{StaticResource OptionCheckBox}"
                                              Margin="0"
                                              ToolTip="Select the two elements first, click the button, done - no picking on screen.&#10;Off means it always asks you to pick, even with two already selected.&#10;Selecting more than two asks you to narrow it down to two."/>
                                </StackPanel>
                            </Border>

                            <!-- Making the new pieces match -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Making the new pieces match" Style="{StaticResource SectionHeader}"/>

                                    <CheckBox x:Name="CopyInsulationCheck"
                                              Content="Copy insulation and lining"
                                              Style="{StaticResource OptionCheckBox}"
                                              ToolTip="Without this a bridging piece comes out bare, and an insulated run ends up with a gap in it."/>

                                    <CheckBox x:Name="CopyWorksetCheck"
                                              Content="Copy Workset"
                                              Style="{StaticResource OptionCheckBox}"
                                              ToolTip="Keeps anything the tool creates on the same workset as the run it joins."/>

                                    <CheckBox x:Name="AutoTransitionCheck"
                                              Content="Add a reducer when the two are different sizes"
                                              Style="{StaticResource OptionCheckBox}"
                                              Margin="0"
                                              ToolTip="Puts the size change in the middle of the new run, so the elbow at each end&#10;stays a plain same-size elbow."/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</Window>
