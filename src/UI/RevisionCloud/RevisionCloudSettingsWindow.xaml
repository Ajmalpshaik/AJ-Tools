<Window x:Class="AJTools.UI.RevisionCloud.RevisionCloudSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revision Cloud By Elements"
        Width="500" Height="364"
        MinWidth="420"
        MinHeight="304"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Revision Cloud By Elements"
                               Style="{StaticResource TitleText}"
                               FontSize="20"/>
                    <TextBlock Text="Configure offset distance for continuous cloud placement."
                               Style="{StaticResource SubtitleText}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Offset Distance"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtOffset"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="50"
                                 TextChanged="TxtOffset_TextChanged"/>
                        <TextBlock Grid.Column="2"
                                   Text="mm"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Used by Revision Clouds &gt; Revision Clouds by Elements (AJ Annotation tab). Press Esc while selecting to stop the continuous run."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Buttons. The inline error sits beside them so it is always visible and adds no
                 height to the window. -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText"
                           Grid.Column="0"
                           Foreground="{StaticResource AccentDanger}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveButton"
                            Content="Save" Style="{StaticResource ModernButton}" MinWidth="110"
                            IsDefault="True"
                            Click="BtnCreate_Click" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="110"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
