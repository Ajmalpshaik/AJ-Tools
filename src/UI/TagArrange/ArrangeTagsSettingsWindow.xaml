<!--
  Tool Name: Arrange Tags - Settings
  Description: Sets the default vertical spacing (mm on paper) used when Rearrange Tags stacks tags.
  Author: Ajmal P.S.
  Version: 1.0.0
  Last Updated: 2026-07-27
  Revit Version: 2020 - latest
  Dependencies: AJTools.UI.ModernStyles
-->
<Window x:Class="AJTools.UI.TagArrange.ArrangeTagsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Tags Settings - AJ Tools"
        Width="520"
        Height="454"
        MinWidth="480"
        MinHeight="424"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PresetChip" TargetType="Button" BasedOn="{StaticResource CompactSecondaryButton}">
                <Setter Property="MinWidth" Value="52"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   Foreground="{StaticResource TextDisabled}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <Grid Margin="10">
            <Border Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Arrange Tags Settings"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Vertical gap used when Rearrange Tags stacks the selected tags."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Spacing input -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Vertical spacing"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SpacingBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     MaxLength="12"
                                     TextChanged="OnSpacingChanged"
                                     ToolTip="Distance between stacked tags, measured on the printed sheet."/>
                            <TextBlock Grid.Column="1"
                                       Text="mm"
                                       FontSize="12"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Presets -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Common values"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,5"/>
                        <StackPanel x:Name="PresetPanel" Orientation="Horizontal">
                            <Button Content="6" Tag="6" Style="{StaticResource PresetChip}" Click="OnPresetClicked"/>
                            <Button Content="8" Tag="8" Style="{StaticResource PresetChip}" Click="OnPresetClicked"/>
                            <Button Content="10" Tag="10" Style="{StaticResource PresetChip}" Click="OnPresetClicked"/>
                            <Button Content="12" Tag="12" Style="{StaticResource PresetChip}" Click="OnPresetClicked"/>
                            <Button Content="15" Tag="15" Style="{StaticResource PresetChip}" Click="OnPresetClicked"/>
                            <Button Content="20" Tag="20" Style="{StaticResource PresetChip}" Click="OnPresetClicked"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live explanation -->
                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Background="{StaticResource BackgroundMedium}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="What this means"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="PreviewText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Inline validation message -->
                    <TextBlock x:Name="ErrorText"
                               Grid.Row="4"
                               FontSize="12"
                               Foreground="{StaticResource AccentDanger}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                    <!-- Footer -->
                    <Grid Grid.Row="6" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="ResetButton"
                                Content="Reset to defaults"
                                Style="{StaticResource CompactSecondaryButton}"
                                MinWidth="120"
                                Click="OnReset"/>

                        <Button Grid.Column="2"
                                x:Name="SaveButton"
                                Content="Save"
                                Style="{StaticResource ModernButton}"
                                MinWidth="104"
                                Margin="0,0,8,0"
                                IsDefault="True"
                                Click="OnSave"/>

                        <Button Grid.Column="3"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                IsCancel="True"
                                Click="OnCancel"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
