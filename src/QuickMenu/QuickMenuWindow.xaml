<!--
  Tool Name: AJ Quick Menu (wheel)
  Description: The game-style radial tool wheel that opens around the mouse pointer. Everything on
               it is drawn in code-behind, because the number of slots is Ajmal's own setting - the
               XAML only provides the transparent shell, the pop-in transform and the canvas.
               The shell is deliberately plain: a see-through window is drawn by the CPU, so no
               effect, blur or opacity animation belongs anywhere on it.
  Author: Ajmal P.S.
  Version: 1.1.0
  Last Updated: 2026-08-20
  Revit Version: 2020 - latest
-->
<Window x:Class="AJTools.UI.QuickMenu.QuickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AJ Quick Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        Focusable="True"
        UseLayoutRounding="True"
        Width="600"
        Height="600">

    <!-- 1/255 alpha: invisible, but the whole square still receives the clicks, so a click in a
         corner (outside the ring) can close the wheel the way it does in a game. -->
    <Grid x:Name="RootGrid"
          Background="#01000000"
          TextElement.FontFamily="Segoe UI"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Canvas x:Name="WheelCanvas"/>
    </Grid>
</Window>
