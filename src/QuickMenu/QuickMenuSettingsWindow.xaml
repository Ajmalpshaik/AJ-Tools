<!--
  Tool Name: AJ Quick Menu (customise)
  Description: Choose which AJ Tools button sits in each slot of the quick wheel, how many slots
               there are, and how big the wheel opens.
  Author: Ajmal P.S.
  Version: 1.0.0
  Last Updated: 2026-08-18
  Revit Version: 2020 - latest
-->
<Window x:Class="AJTools.UI.QuickMenu.QuickMenuSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Menu - Customise"
        Width="900"
        Height="640"
        MinWidth="780"
        MinHeight="540"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../UI/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondary}"
                       Text="Created &amp; All Rights Reserved @ Ajmal P.S."/>

            <Button x:Name="SaveButton"
                    Grid.Column="1"
                    Content="Save"
                    Style="{StaticResource SuccessButton}"
                    IsDefault="True"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="OnSaveClick"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="110"
                    Click="OnCancelClick"/>
        </Grid>

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Quick Menu" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource SubtitleText}"
                       TextWrapping="Wrap"
                       Text="Pick a tool on the left, pick a slot on the right, then press Set. Slot 1 is at the top of the wheel and the rest follow clockwise."/>
        </StackPanel>

        <!-- Wheel options -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Slots on the wheel"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource TextSecondary}"/>
                <ComboBox x:Name="SlotCountCombo"
                          Width="90"
                          VerticalAlignment="Center"
                          SelectionChanged="OnSlotCountChanged"/>

                <TextBlock Text="Wheel size"
                           VerticalAlignment="Center"
                           Margin="24,0,8,0"
                           Foreground="{StaticResource TextSecondary}"/>
                <ComboBox x:Name="WheelSizeCombo"
                          Width="150"
                          VerticalAlignment="Center"
                          SelectionChanged="OnWheelSizeChanged"/>

                <TextBlock x:Name="ShortcutHintText"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextDisabled}"
                           Text="Tip: give the Quick Menu button a Revit keyboard shortcut so the wheel opens right under your pointer."/>
            </StackPanel>
        </Border>

        <!-- Tools / actions / slots -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- All AJ Tools buttons -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="AJ Tools buttons - type below to search"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="SearchBox"
                             DockPanel.Dock="Top"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,8"
                             TextChanged="OnSearchTextChanged"/>

                    <TextBlock x:Name="ToolCountText"
                               DockPanel.Dock="Bottom"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextDisabled}"/>

                    <ListBox x:Name="ToolList"
                             Style="{StaticResource ModernListBox}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                             MouseDoubleClick="OnToolListDoubleClick"/>
                </DockPanel>
            </Border>

            <!-- Middle actions -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                <Button x:Name="AssignButton"
                        Content="Set  &#x2192;"
                        Style="{StaticResource CompactPrimaryButton}"
                        MinWidth="96"
                        Margin="0,0,0,8"
                        Click="OnAssignClick"/>
                <Button x:Name="ClearButton"
                        Content="Clear slot"
                        Style="{StaticResource CompactSecondaryButton}"
                        MinWidth="96"
                        Margin="0,0,0,20"
                        Click="OnClearClick"/>
                <Button x:Name="MoveUpButton"
                        Content="Move up"
                        Style="{StaticResource CompactSecondaryButton}"
                        MinWidth="96"
                        Margin="0,0,0,8"
                        Click="OnMoveUpClick"/>
                <Button x:Name="MoveDownButton"
                        Content="Move down"
                        Style="{StaticResource CompactSecondaryButton}"
                        MinWidth="96"
                        Click="OnMoveDownClick"/>
            </StackPanel>

            <!-- The wheel slots -->
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Wheel slots (1 = top, then clockwise)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <ListBox x:Name="SlotList"
                             Style="{StaticResource ModernListBox}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
