<!--
Tool Name : C# Saved Scripts
Purpose   : Standalone window listing every .cs file in the configured Scripts Folder, with Pin/Run
            per row - moved out of the C# pane's "Saved Scripts History" expander per Ajmal's request
            ("move that to separate tool... same like run pinned"), so it's reachable via its own
            ribbon button (AI Assistant panel) whether or not the C# pane is open. Opened by
            ShowSavedScriptsCommand, which passes in the live ExternalCommandData so "▶ Run" can
            execute a script directly.
Author    : Ajmal P.S.
Version   : 1.0.0
Last Updated : 2026-07-21
-->
<Window x:Class="AJTools.AiShell.Views.SavedScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Saved Scripts"
        Width="480" Height="560" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SoftUiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Outer layer paints the full window edge-to-edge; a root element can't StaticResource its
         own Resources on its own attributes, so background/foreground live one level down. -->
    <DockPanel Background="{StaticResource SurfaceBrush}" TextElement.Foreground="{StaticResource TextBrush}">
    <!-- Footer -->
    <TextBlock DockPanel.Dock="Bottom"
               Text="Created &amp; All Rights Reserved @ Ajmal P.S."
               Foreground="{StaticResource MutedBrush}"
               FontSize="11"
               HorizontalAlignment="Center"
               Margin="0,0,0,8"/>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SoftCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Saved Scripts" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Folder" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderPathBox" IsReadOnly="True" Style="{StaticResource SoftTextBoxStyle}"/>
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseFolder_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,6"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" x:Name="PinnedStatusText" Foreground="{StaticResource MutedBrush}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyStateText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="No .cs scripts found in this folder yet. Save one from the C# pane's &quot;Save Script&quot; button, or change the folder above."
                       Visibility="Collapsed" Margin="4,12,4,0"/>
            <ListBox x:Name="ScriptsListBox" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SoftCardBrush}" CornerRadius="10" Margin="0,3" Padding="10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" ToolTip="{Binding ToolTipText}"/>
                                <Button Grid.Column="1" Content="📌 Pin" Click="PinScript_Click"
                                        ToolTip="Pin this script to the &quot;Run Pinned&quot; ribbon button for one-click, no-code re-runs."
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="10,4" FontSize="11"/>
                                <Button Grid.Column="2" Content="▶ Run" Click="RunScript_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="10,4" FontSize="11"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"/>
            <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource PrimaryButtonStyle}" IsCancel="True" Margin="10,0,0,0" Padding="18,8"/>
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
