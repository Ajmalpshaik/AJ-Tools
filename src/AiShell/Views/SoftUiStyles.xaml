<!--
Tool Name : C# / AJ AI Bridge shared UI styles
Purpose   : Soft Revit UI resource dictionary (Neumorphism + Claymorphism, Neon Blue primary, dark
            theme) shared by AiShellView.xaml (the docked pane), SettingsWindow.xaml and
            SavedScriptsWindow.xaml, so all three surfaces stay visually consistent from one source.
Author    : Ajmal P.S.
Version   : 1.1.0
Last Updated : 2026-08-05
Changelog : v1.1.0 - Interaction motion, matched to the suite theme (UI/ModernStyles.xaml v1.3.0) so the
            AI shell feels like the same product as the tool windows: hover wash, press dip, focus ring
            and enable/disable fade on buttons; hover + focus rings on text and password fields; the
            dropdown arrow rotates while the list is open. Same two house rules as ModernStyles - never
            animate Background/Foreground in a shared style, and one trigger per animated property.
            The instant Background swaps on the Primary/Secondary/Warning buttons are replaced by the
            animated overlays, which land on very nearly the same colours (Primary pressed lands within
            one shade of the old PrimaryPressedBrush). ProgressBarStyle deliberately left alone.
            v1.0.0 - Initial soft UI dictionary.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- Soft Revit UI — Neon Blue, dark theme -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#00C8FF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#37D7FF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#009FCC"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#062028"/>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2428"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2A3035"/>
    <SolidColorBrush x:Key="SoftCardBrush" Color="#303840"/>
    <SolidColorBrush x:Key="SoftCardHoverBrush" Color="#39424B"/>

    <SolidColorBrush x:Key="TextBrush" Color="#F2F7FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B4BE"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#46515A"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#E57373"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#81C784"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#2B2205"/>

    <!-- ============================================================
         Motion (v1.1.0). Deliberately identical timing + easing to UI/ModernStyles.xaml so the AI
         shell and the tool windows feel like one product: hover 90ms in / 160ms out, press 110ms,
         release and settle 240ms, focus ring 140ms, enable/disable 120ms.
         Same two rules as that file, and they matter here too:
         1. Never animate Background or Foreground in a shared style - an animation outruns a
            locally-set value. Animate an overlay's Opacity or a RenderTransform instead.
         2. One trigger per animated property, each state owning its own overlay, so hover, press
            and focus cannot overwrite each other when more than one is true at once.
         ============================================================ -->
    <CubicEase x:Key="MotionEaseOut" EasingMode="EaseOut"/>

    <!-- Soft card: rounded, subtle border, shadow reserved for the main/floating cards only -->
    <Style x:Key="SoftCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Base soft button: rounded, no chrome. Hover/press/focus are animated overlays on top of the
         fill, NOT background swaps - see the motion rules above. The overlays are neutral (white wash,
         black shade) so one template serves the primary, secondary and warning buttons; on this palette
         they land within a shade of the colours the old instant swaps produced. -->
    <Style x:Key="SoftButtonBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <Border x:Name="HoverGlow" CornerRadius="10" Background="#26FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="PressShade" CornerRadius="10" Background="#33000000"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShade" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The three button colours below carry no hover/press triggers of their own any more: hover and
         press come from the animated overlays in SoftButtonBase, so all three behave identically and
         a fourth colour can be added by setting Background alone.
         PrimaryHoverBrush / PrimaryPressedBrush / SoftCardHoverBrush stay defined above - they are part
         of the palette and are still used elsewhere (dropdown rows). -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBase}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBase}">
        <Setter Property="Background" Value="{StaticResource SoftCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonBase}">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Soft text field: rounded card, Neon Blue focus ring -->
    <Style x:Key="SoftTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <!-- Two rings, one owned by hover and one by focus, so a hovered AND focused
                             field cannot have the two states overwrite each other. -->
                        <Border x:Name="HoverRing" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Masked variant of SoftTextBoxStyle for secret entry (API keys) - PasswordBox can't share the
         TextBox-targeted style/template above (different TargetType), so it gets its own copy of the
         same look. -->
    <Style x:Key="SoftPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <Border x:Name="HoverRing" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Monospace variant for the code editor's surrounding chrome / output console -->
    <Style x:Key="SoftMonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Full custom ComboBox chrome. A "colors only" restyle (just setting Background/Foreground
         property values) does NOT work for ComboBox - the default Windows theme's internal toggle-
         button chrome ignores the outer ComboBox.Background, which is why the dropdowns kept
         showing white/system-grey even with the brush set. Needs a real Template like this. -->
    <Style x:Key="SoftComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <!-- Highlight fades as an overlay; selection stays an instant fill underneath. -->
                        <Border x:Name="HighlightGlow" Background="#26FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HighlightGlow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HighlightGlow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SoftCardBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SoftComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ComboArrow" Grid.Column="1" Text="&#9662;" FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform x:Name="ComboArrowRotate" Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <!-- One ring per state, same rule as everywhere else in this file. -->
                                        <Border x:Name="HoverRing" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                                        <Border x:Name="OpenRing" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{StaticResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                                         To="0.55" Duration="0:0:0.09"
                                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.16"
                                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="OpenRing" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.14"
                                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                                        <DoubleAnimation Storyboard.TargetName="ComboArrowRotate" Storyboard.TargetProperty="Angle"
                                                                         To="180" Duration="0:0:0.18"
                                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="OpenRing" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.16"
                                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                                        <DoubleAnimation Storyboard.TargetName="ComboArrowRotate" Storyboard.TargetProperty="Angle"
                                                                         To="0" Duration="0:0:0.18"
                                                                         EasingFunction="{StaticResource MotionEaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                           Content="{TemplateBinding SelectionBoxItem}"
                                           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                           Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}"
                               PlacementTarget="{Binding ElementName=ToggleButton}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="150"
                                    MaxHeight="240">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colors only, on purpose - and the reason is NOT what an earlier note here claimed.
         Verified 2026-08-05 by reflection over the real PresentationFramework.dll: ProgressBar declares
         [TemplatePart] PART_Track / PART_Indicator / PART_GlowRect and sizes the indicator itself in its
         private SetProgressBarIndicatorLength(), so a custom template does NOT need its own width math -
         it only needs those part names. UI/ModernStyles.xaml v1.3.0 uses a custom template on that basis.
         The real reason this one keeps the default chrome: AiShellView's busy strip is
         IsIndeterminate="True" and relies on WPF's own sliding-glow animation. Replacing that with a
         hand-written one would swap something that already works for something that might not, on the
         indicator Ajmal watches while an AI task runs. Not worth it for a corner-radius detail. -->

    <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
