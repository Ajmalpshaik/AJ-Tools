<Project>

  <!-- ================================================================
       Debug/Release behaviour for the version configurations.
       The .NET SDK only recognises the exact names "Debug"/"Release";
       ours include "Debug R24", "Release R27", etc.
       ================================================================ -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <!-- ================================================================
       Auto-deploy: current-user payload copy under AppData for the Revit
       version being built. Each build gets its own payload folder; the
       top-level manifest points to that folder on the next Revit start.
       This is the only build-time deploy. All-users installs go through
       dist\install-all-users.cmd, which ships the complete payload. (A
       ProgramData deploy target lived here until 2026-10-12; it had been
       switched off since 2026-08-12 because it installed without the NuGet
       dependencies under the same AddInId - see ajtools-conventions.md.)
       ================================================================ -->
  <Target Name="AutoDeployRevitAddin"
          AfterTargets="Build"
          Condition="'$(SkipAjToolsAutoDeploy)' != 'true'">
    <Message Text="Deploying Add-in payload for Revit $(RevitVersion)..." Importance="high" />

    <ItemGroup>
      <AddinFiles Include="$(OutputPath)**\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(RevitAddinsRootPath);$(RevitAddinPayloadPath);@(AddinFiles->'$(RevitAddinPayloadPath)%(RecursiveDir)')" />

    <Copy SourceFiles="@(AddinFiles)"
          DestinationFiles="@(AddinFiles->'$(RevitAddinPayloadPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <WriteLinesToFile File="$(RevitAddinManifestPath)"
                      Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot; standalone=&quot;no&quot;?&gt;&#x0D;&#x0A;&lt;RevitAddIns&gt;&#x0D;&#x0A;  &lt;AddIn Type=&quot;Application&quot;&gt;&#x0D;&#x0A;    &lt;Name&gt;AJ Tools&lt;/Name&gt;&#x0D;&#x0A;    &lt;AddInId&gt;{C14A253D-96C6-42B7-889A-CFE737556BA9}&lt;/AddInId&gt;&#x0D;&#x0A;    &lt;FullClassName&gt;AJTools.App.App&lt;/FullClassName&gt;&#x0D;&#x0A;    &lt;Assembly&gt;$(RevitAddinPayloadPath)AJ Tools.dll&lt;/Assembly&gt;&#x0D;&#x0A;    &lt;VendorId&gt;AJT&lt;/VendorId&gt;&#x0D;&#x0A;    &lt;VendorDescription&gt;Ajmal P.S - ajmalnattika@gmail.com&lt;/VendorDescription&gt;&#x0D;&#x0A;  &lt;/AddIn&gt;&#x0D;&#x0A;&lt;/RevitAddIns&gt;"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8" />

    <Message Text="SUCCESS: Copied add-in payload to $(RevitAddinPayloadPath) and updated $(RevitAddinManifestPath)" Importance="high" />

    <!-- Sweep up old payload folders. Every build creates a fresh timestamped one (it has to - a
         running Revit locks the current DLL) but nothing ever removed the previous ones. Measured
         2026-08-12: 75 abandoned folders, 2,086 MB, accumulated since July.

         Keeps the newest 2 - the live one plus one to roll back to. Anything a running Revit still
         holds open simply fails to delete and gets swept on a later build, which is why this is
         best-effort and can never fail the build. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$root = '$(RevitAddinsRootPath)'; if (Test-Path $root) { Get-ChildItem $root -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^AJ Tools\.\d+$' } | Sort-Object LastWriteTime -Descending | Select-Object -Skip 2 | ForEach-Object { try { Remove-Item -LiteralPath $_.FullName -Recurse -Force -ErrorAction Stop } catch { } } }&quot;"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>

</Project>
