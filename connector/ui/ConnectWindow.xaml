<Window x:Class="AJToolsConnector.UI.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AJ Connect"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- NOTE: no Background/Foreground/StaticResource on this Window tag itself. WPF processes a
         root element's own attributes BEFORE its Resources dictionary exists, so a StaticResource
         here always fails at runtime with "Cannot find resource named ..." - and in an add-in that
         builds its UI during start-up, that takes the whole thing down. Set them on the first child
         instead (RootPanel below). Same rule AJ Tools learned the hard way in v1.16.0. -->

    <Window.Resources>
        <SolidColorBrush x:Key="Ground"    Color="#F2F5F9" />
        <SolidColorBrush x:Key="Surface"   Color="#FFFFFF" />
        <SolidColorBrush x:Key="Line"      Color="#D3DCE8" />
        <SolidColorBrush x:Key="Ink"       Color="#0E1620" />
        <SolidColorBrush x:Key="Ink2"      Color="#46566B" />
        <SolidColorBrush x:Key="Ink3"      Color="#7A8AA0" />
        <SolidColorBrush x:Key="Accent"    Color="#1F76FF" />
        <SolidColorBrush x:Key="AccentDeep" Color="#0B4CC4" />
        <SolidColorBrush x:Key="Ok"        Color="#0E9B57" />
        <SolidColorBrush x:Key="Stop"      Color="#C8342B" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" Background="{StaticResource Ground}">

        <!-- Credit footer, docked so the layout above never has to shift for it (house rule). -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Created &amp; All Rights Reserved @ Ajmal P.S."
                   FontSize="11"
                   Foreground="{StaticResource Ink3}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

        <StackPanel Margin="16,16,16,12">

            <!-- Identity -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="34" Height="34" CornerRadius="9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1F76FF" Offset="0" />
                            <GradientStop Color="#0B4CC4" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="AJ" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AJ Connect" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="VersionText" Text="Revit tools in your browser"
                               FontSize="11" Foreground="{StaticResource Ink3}" />
                </StackPanel>
            </StackPanel>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Stop}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="Not connected" FontSize="13.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="AddressText" Text="" FontSize="11.5" FontFamily="Consolas"
                               Foreground="{StaticResource Ink3}" Margin="17,4,0,0" />
                </StackPanel>
            </Border>

            <!-- The one switch -->
            <Button x:Name="ConnectButton"
                    Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource Accent}"
                    Content="Connect"
                    Margin="0,0,0,8"
                    Click="ConnectButton_Click" />

            <Button x:Name="OpenButton"
                    Style="{StaticResource QuietButton}"
                    Content="Open the tools page"
                    Margin="0,0,0,14"
                    Click="OpenButton_Click" />

            <!-- Where tools come from -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TOOLS COME FROM" Style="{StaticResource Label}" />
                    <TextBox x:Name="SourceBox"
                             FontSize="12"
                             Padding="8,6"
                             BorderBrush="{StaticResource Line}"
                             BorderThickness="1"
                             Foreground="{StaticResource Ink}"
                             TextChanged="SourceBox_TextChanged" />
                    <TextBlock x:Name="SourceHint"
                               Text="A folder on this computer, or your website address."
                               FontSize="11" Foreground="{StaticResource Ink3}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="UseLocalButton" Style="{StaticResource QuietButton}"
                                Content="Use local folder" Margin="0,0,8,0"
                                Click="UseLocalButton_Click" />
                        <Button x:Name="SaveSourceButton" Style="{StaticResource QuietButton}"
                                Content="Save" Click="SaveSourceButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</Window>
