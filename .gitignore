# OS files
Thumbs.db
desktop.ini
.DS_Store

# Local safety backups (pre-multiversion conversion)
_backup/

# Stale pre-multiversion copy of the project. The live source tree is root src/.
# This folder is a near-identical duplicate and must never be committed from here.
AJ Tools/

# The installer ships from its own separate GitHub repository
# (Ajmalpshaik/AJ-Tools-Installer) and carries its own .git.
AJ-Tools-Installer/

# Knowledge graph outputs (generated by /graphify; graph.json runs to tens of MB)
graphify-out/
graphify-out-*/

# Claude working folder: everything is backed up EXCEPT machine-local state.
# settings.local.json is per-machine by design and scheduled_tasks.lock is runtime state -
# both would only create noise between machines. The knowledge, skills, scripts and
# scratch folders ARE tracked on purpose; they are the accumulated working memory.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# AJ Connect build output. Payload/ is a copy of bin/, release/ holds the ~5.5 MB installer zip,
# and publish/ is generated by tools/publish-tools.ps1 - all rebuilt from source by one command,
# so committing them only bloats history. The tool SOURCES (connector/tools-source/) and the
# scripts that produce these ARE tracked - they are the real inputs.
connector/dist/Payload/
connector/dist/release/
connector/dist/publish/
