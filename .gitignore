# Local safety backups (pre-multiversion conversion)
_backup/

# The old pre-multiversion copy of the project lived here until 2026-10-12 (deleted then).
# The live source tree is root src/. If an "AJ Tools/" folder ever reappears it is a stale
# copy - never commit from it.
AJ Tools/

# The installer ships from its own separate GitHub repository
# (Ajmalpshaik/AJ-Tools-Installer) and carries its own .git.
AJ-Tools-Installer/

# Claude working folder: everything is backed up EXCEPT machine-local state.
# settings.local.json is per-machine by design and scheduled_tasks.lock is runtime state -
# both would only create noise between machines. worktrees/ holds temporary working copies
# made by AI sessions. The knowledge, skills and tools folders ARE tracked on purpose; they are
# the accumulated working memory.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# A separate product used to live under this root and was moved out to its own repository.
# Two copies of anything drift apart, which has already cost real time here once with the old
# "AJ Tools\" tree. If one of these folders reappears under this root it is a stale copy, not work.
connector/
connector-tools/
